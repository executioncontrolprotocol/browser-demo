{
  "name": "@executioncontrolprotocol/browser-demo",
  "version": "0.13.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "description": "ECP Graph Editor — browser demo app (Vite + React)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck && pnpm run lint:yaml",
    "build": "pnpm run typecheck && vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run secrets:scan && pnpm run check:no-file-deps && pnpm test && pnpm run build",
    "secrets:scan": "secretlint \"**/*\"",
    "check:no-file-deps": "node scripts/check-no-file-deps.mjs",
    "lint:yaml": "node scripts/lint-yaml.mjs",
    "link:ecp": "node scripts/link-ecp-packages.mjs",
    "link:host": "node scripts/link-host-example.mjs",
    "link:vendor": "node scripts/link-vendor-extensions.mjs",
    "dev:linked": "node scripts/dev-linked.mjs",
    "ci:setup": "node scripts/ci-setup-ecp.mjs",
    "supabase:push": "supabase db push",
    "supabase:status": "supabase migration list",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "secretlint --no-glob"
    ],
    "*.{yml,yaml}": [
      "node scripts/lint-yaml.mjs"
    ]
  },
  "dependencies": {
    "@executioncontrolprotocol/browser": "catalog:ecp",
    "@executioncontrolprotocol/chrome-ai": "catalog:ecp",
    "@executioncontrolprotocol/claude": "catalog:ecp",
    "@executioncontrolprotocol/core": "catalog:ecp",
    "@executioncontrolprotocol/extension-ollama": "catalog:ecp",
    "@executioncontrolprotocol/extension-openai": "catalog:ecp",
    "@executioncontrolprotocol/format-eql": "catalog:ecp",
    "@executioncontrolprotocol/format-mermaid": "catalog:ecp",
    "@executioncontrolprotocol/format-reactflow": "catalog:ecp",
    "@executioncontrolprotocol/format-toon": "catalog:ecp",
    "@executioncontrolprotocol/harnesses-browser-coding": "catalog:ecp",
    "@executioncontrolprotocol/harnesses-browser-nano": "catalog:ecp",
    "@executioncontrolprotocol/types": "catalog:ecp",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.3",
    "esbuild-wasm": "^0.25.0",
    "mermaid": "^11.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.15",
    "secretlint": "^13.0.4",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "vite": "^6.4.3",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.61.1"
  },
  "peerDependencies": {
    "@executioncontrolprotocol/adobe-firefly-services": "catalog:ecp",
    "@executioncontrolprotocol/azure-blob-storage": "catalog:ecp",
    "@executioncontrolprotocol/fal": "catalog:ecp",
    "@executioncontrolprotocol/image-sharp": "catalog:ecp"
  },
  "peerDependenciesMeta": {
    "@executioncontrolprotocol/adobe-firefly-services": {
      "optional": true
    },
    "@executioncontrolprotocol/azure-blob-storage": {
      "optional": true
    },
    "@executioncontrolprotocol/fal": {
      "optional": true
    },
    "@executioncontrolprotocol/image-sharp": {
      "optional": true
    }
  }
}

