{
  "name": "@executioncontrolprotocol/browser-demo",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "description": "ECP Graph Editor — browser demo app (Vite + React)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "build": "npm run typecheck && vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "secrets:scan": "secretlint \"**/*\"",
    "supabase:push": "supabase db push",
    "supabase:status": "supabase migration list",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "secretlint --no-glob"
    ]
  },
  "dependencies": {
    "@executioncontrolprotocol/browser": "^0.10.1",
    "@executioncontrolprotocol/chrome-ai": "^0.10.1",
    "@executioncontrolprotocol/claude": "^0.10.1",
    "@executioncontrolprotocol/core": "^0.10.1",
    "@executioncontrolprotocol/extension-fal": "^0.10.1",
    "@executioncontrolprotocol/extension-image-sharp": "^0.10.1",
    "@executioncontrolprotocol/extension-ollama": "^0.10.1",
    "@executioncontrolprotocol/extension-openai": "^0.10.1",
    "@executioncontrolprotocol/format-eql": "^0.10.1",
    "@executioncontrolprotocol/format-mermaid": "^0.10.1",
    "@executioncontrolprotocol/format-reactflow": "file:../executioncontrolprotocol/packages/extensions/format-reactflow",
    "@executioncontrolprotocol/format-toon": "^0.10.1",
    "@executioncontrolprotocol/harnesses-browser-coding": "^0.10.1",
    "@executioncontrolprotocol/harnesses-browser-nano": "^0.10.1",
    "@executioncontrolprotocol/types": "^0.10.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.3",
    "esbuild-wasm": "^0.25.0",
    "mermaid": "^11.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.15",
    "secretlint": "^13.0.4",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.61.1"
  }
}
