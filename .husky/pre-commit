set -e
if git diff --cached --name-only | grep -qE '^(pnpm-lock\.yaml|package\.json|pnpm-workspace\.yaml)$'; then
  if pnpm install; then
    git add pnpm-lock.yaml
  else
    echo "pnpm install skipped: catalog range not on npm yet (publish core first or use link:ecp)."
  fi
  # Re-link after install — pnpm rewrites node_modules and drops prior junctions.
  pnpm run link:ecp 2>/dev/null || true
fi
if [ -f "../extensions/package.json" ] || [ -n "$EXTENSIONS_ROOT" ]; then
  pnpm run link:vendor -- --skip-install
fi
pnpm exec lint-staged
pnpm run check:no-file-deps
pnpm run lint
